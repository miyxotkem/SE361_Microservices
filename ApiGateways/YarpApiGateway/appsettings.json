{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "courses-route": {
        "ClusterId": "course-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        }
      },
      "exams-route": {
        "ClusterId": "exam-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/exams/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "comments-route": {
        "ClusterId": "comment-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/comments/{**catch-all}"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "enrollment-hub-route": {
        "ClusterId": "course-cluster",
        "RateLimiterPolicy": "api-limiter",
        "Match": {
          "Path": "/course-api/hubs/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/hubs/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "identity-1": {
            "Address": "http://identity.api:8080"
          }
        }
      },
      "course-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "course-1": {
            "Address": "http://course.api.1:8080"
          },
          "course-2": {
            "Address": "http://course.api.2:8080"
          },
          "course-3": {
            "Address": "http://course.api.3:8080"
          }
        }
      },
      "exam-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Destinations": {
          "exam-1": {
            "Address": "http://exam.api.1:8080"
          },
          "exam-2": {
            "Address": "http://exam.api.2:8080"
          }
        }
      },
      "notification-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "notification-1": {
            "Address": "http://notification.api:8080"
          }
        }
      },
      "comment-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "comment-1": {
            "Address": "http://comment.api:8080"
          }
        }
      },
      "payment-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "payment-1": {
            "Address": "http://payment.api:8080"
          }
        }
      },
      "admin-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "admin-1": {
            "Address": "http://admin.api:8080"
          }
        }
      }
    }
  }
}
